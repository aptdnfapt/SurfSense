# SurfSense Configuration
# Generated by install.sh

# ===== DOCKER IMAGE SETTINGS =====
# Backend image variant (CPU or GPU)
BACKEND_IMAGE_TAG=latest
# GitHub repository owner (change if you forked)
GITHUB_REPO_OWNER=surfsense

# ===== DATABASE CONFIGURATION =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_AUTO_GENERATED
POSTGRES_DB=surfsense
POSTGRES_PORT=5432

# ===== SECURITY =====
# Secret key for JWT tokens (auto-generated)
SECRET_KEY=CHANGE_ME_AUTO_GENERATED

# ===== AUTHENTICATION =====
# Options: LOCAL or GOOGLE
AUTH_TYPE=LOCAL

# Google OAuth (only if AUTH_TYPE=GOOGLE)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# ===== FRONTEND CONFIGURATION =====
FRONTEND_PORT=3000
NEXT_FRONTEND_URL=http://localhost:3000

# Backend URL for browser/client-side requests
# For local install: http://localhost:8000
# For remote server: https://api.yourdomain.com or https://yourdomain.com/api
NEXT_PUBLIC_FASTAPI_BACKEND_URL=http://localhost:8000

# ===== BACKEND CONFIGURATION =====
BACKEND_PORT=8000

# ===== DOCUMENT PROCESSING =====
# Options: UNSTRUCTURED, DOCLING, LLAMACLOUD
ETL_SERVICE=UNSTRUCTURED

# ===== EMBEDDING & SEARCH =====
EMBEDDING_MODEL=mixedbread-ai/mxbai-embed-large-v1
RERANKERS_MODEL_NAME=ms-marco-MiniLM-L-12-v2
RERANKERS_MODEL_TYPE=flashrank

# ===== TEXT-TO-SPEECH (PODCASTS) =====
# Options: local/kokoro, openai/tts-1
TTS_SERVICE=local/kokoro
TTS_SERVICE_API_KEY=
TTS_SERVICE_API_BASE=

# ===== SPEECH-TO-TEXT (VIDEO TRANSCRIPTION) =====
# Options: openai/whisper-1, groq/whisper-large-v3
STT_SERVICE=
STT_SERVICE_API_KEY=
STT_SERVICE_API_BASE=

# ===== AIRTABLE INTEGRATION (OPTIONAL) =====
AIRTABLE_CLIENT_ID=
AIRTABLE_CLIENT_SECRET=
AIRTABLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/airtable/connector/callback

# ===== GOOGLE OAUTH REDIRECT URIS (OPTIONAL) =====
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/calendar/connector/callback
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/gmail/connector/callback

# ===== FIRECRAWL API (OPTIONAL) =====
FIRECRAWL_API_KEY=

# ===== ETL SERVICE API KEYS (OPTIONAL) =====
UNSTRUCTURED_API_KEY=
LLAMA_CLOUD_API_KEY=

# ===== LANGSMITH OBSERVABILITY (OPTIONAL) =====
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=surfsense

# ===== UVICORN SERVER CONFIGURATION (OPTIONAL) =====
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8000
UVICORN_LOG_LEVEL=info

# ===== PGADMIN =====
PGADMIN_PORT=5050
PGADMIN_DEFAULT_EMAIL=admin@surfsense.com
PGADMIN_DEFAULT_PASSWORD=surfsense
